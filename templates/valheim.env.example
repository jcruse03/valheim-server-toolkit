# Copy to valheim.env in the instance directory and chmod 600.
# Do not commit the real file: it contains the server password.
SERVER_NAME="My Valheim Server"
SERVER_PORT="2456"
WORLD_NAME="Dedicated"
SERVER_PASSWORD="replace-with-a-long-password"
SAVE_DIR="/home/jim/games/valheim-example/saves"

# 0 starts clean Valheim without loading BepInEx. This is the launch-day
# fallback when a game update lands before the pinned mod stack is compatible.
MODS_ENABLED="1"

# 1 advertises the server and supports the easiest crossplay discovery/join flow.
SERVER_PUBLIC="1"

# 1 selects Valheim's PlayFab crossplay backend. Console players can join, but
# they cannot install BepInEx and therefore cannot use Cross Server Portals.
CROSSPLAY="1"

# muchmore is Valheim's built-in 2x resource-rate preset. It is broad, not
# limited to wood/stone/building materials. Use an empty value for standard.
RESOURCE_PRESET="muchmore"
