[Unit]
Description=Valheim dedicated server (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=jim
Group=jim
WorkingDirectory=/home/jim/games/%i
ExecStart=/home/jim/games/%i/valheim-serve.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
